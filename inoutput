  function fieldPill(field, type) {
    const [id, cn, en] = field;
    const cls = id === "待细化" ? "field warn" : `field ${type}`;
    return `<span class="${cls}" title="${en || ""}">${id}｜${cn}${en ? "｜" + en : ""}</span>`;
  }

  function renderCards() {
    const root = document.getElementById("cards");
    root.innerHTML = models.map(m => `
      <article class="card" data-search="${[
        m.id, m.name, m.short, m.category, m.desc, m.downstream,
        ...m.inputs.flat(), ...m.outputs.flat()
      ].join(" ").toLowerCase()}">
        <div class="card-head">
          <div>
            <div class="model-title">${m.name}</div>
            <div class="model-meta">${m.short}｜${m.category}</div>
          </div>
          <div class="id-tag">${m.id}</div>
        </div>

        <div class="model-meta">${m.desc}</div>

        <div class="io-block">
          <div class="io-title">输入字段</div>
          <div class="field-list">
            ${m.inputs.map(f => fieldPill(f, "input")).join("")}
          </div>
        </div>

        <div class="io-block">
          <div class="io-title">输出字段</div>
          <div class="field-list">
            ${m.outputs.map(f => fieldPill(f, "output")).join("")}
          </div>
        </div>

        <div class="io-block">
          <div class="io-title">下游去向</div>
          <div class="field-list">
            <span class="field source">${m.downstream}</span>
          </div>
        </div>
      </article>
    `).join("");
  }

  function renderEdges() {
    const tbody = document.querySelector("#edgeTable tbody");
    tbody.innerHTML = edges.map(e => `
      <tr data-search="${Object.values(e).join(" ").toLowerCase()}">
        <td><strong>${e.id}</strong></td>
        <td>${e.from}</td>
        <td>${e.to}</td>
        <td>${e.field}</td>
        <td>${e.role}</td>
        <td>${e.note}</td>
      </tr>
    `).join("");
  }

  function bindSearch() {
    const input = document.getElementById("search");

    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();

      document.querySelectorAll(".card").forEach(card => {
        const hit = card.dataset.search.includes(q);
        card.classList.toggle("hidden", q && !hit);
      });

      document.querySelectorAll("#edgeTable tbody tr").forEach(row => {
        const hit = row.dataset.search.includes(q);
        row.style.display = q && !hit ? "none" : "";
      });
    });
  }

  renderCards();
  renderEdges();
  bindSearch();
</script>
